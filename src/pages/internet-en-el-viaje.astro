---
// Página «Internet en el viaje» (acuerdo con Glowi). Reglas: enlaces a Glowi SOLO mediante <EnlaceGlowi>
// (rel="sponsored noopener"), transparencia junto al código, sin precios, sin pop-ups ni banners.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CodigoDescuento from "../components/CodigoDescuento.astro";
import EnlaceGlowi from "../components/EnlaceGlowi.astro";
import Forma from "../components/Forma.astro";
import Icono from "../components/Icono.astro";
import { GLOWI } from "../config/glowi";
import fotoPuerta from "../assets/fotos/amalia-puerta-mezquita-recorte.jpg";
---

<Base
  titulo="Internet en el viaje: cómo tener datos en Marruecos"
  descripcion="Cómo tengo internet en Marruecos sin roaming ni sustos: una eSIM que instalas antes de salir. Te explico cómo funciona, cuántos GB necesitas y mi código de descuento."
>
  <!-- 1. Hero -->
  <section class="ihero" aria-labelledby="ihero-titulo">
    <div class="contenedor ihero__rejilla">
      <div class="ihero__texto">
        <p class="eyebrow">Antes de salir</p>
        <h1 id="ihero-titulo">Internet en el <span class="acento">viaje</span></h1>
        <p class="entradilla">
          Lo primero que vas a querer hacer al bajar del avión es mandar un «ya he llegado» a casa. Te cuento cómo lo hago
          yo para tener internet en Marruecos sin sustos.
        </p>
        <a href="#codigo" class="ihero__ancla">Ir al código <Icono nombre="abajo" tam={18} /></a>
      </div>
      <div class="ihero__foto">
        <Forma tipo="circulo" color="azul" tam="clamp(80px, 20vw, 130px)" class="ihero__circulo" />
        <div class="arco" style="--arco-color: var(--rojo)">
          <Image
            src={fotoPuerta}
            alt="Amalia apoyada en una gran puerta de madera con remaches en Marrakech"
            widths={[320, 480, 640, 816]}
            sizes="(min-width: 960px) 420px, 80vw"
            loading="eager"
            fetchpriority="high"
            quality={72}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Por qué hace falta -->
  <section class="seccion" aria-labelledby="porque-titulo">
    <div class="contenedor texto">
      <p class="eyebrow">Por qué hace falta</p>
      <h2 id="porque-titulo">Marruecos está fuera de la <span class="acento">UE</span></h2>
      <p class="entradilla">
        Así que tu tarifa española no incluye roaming allí, y la factura a la vuelta puede dar más miedo que el primer
        regateo en el zoco.
      </p>
      <p>
        Y la otra opción, ponerte a buscar una SIM en el aeropuerto con todo el grupo esperando y las maletas recién
        recogidas, es bastante incómoda. Yo prefiero llegar con los datos ya funcionando.
      </p>
    </div>
  </section>

  <!-- 3. Qué es una eSIM -->
  <section class="seccion pasos" aria-labelledby="pasos-titulo">
    <div class="contenedor">
      <p class="eyebrow">Qué es una eSIM</p>
      <h2 id="pasos-titulo">Una SIM digital, en <span class="acento">3 pasos</span></h2>
      <p class="texto">
        Una eSIM es una tarjeta SIM sin plástico: se instala en el móvil y te da datos en el país de destino. Así lo hago yo:
      </p>
      <ol class="pasos__lista">
        <li>
          <span class="pasos__num">1</span>
          <Icono nombre="compra" tam={28} class="pasos__icono" />
          <h3>La compras antes de salir.</h3>
          <p>Desde casa y con calma, sin colas ni mostradores.</p>
        </li>
        <li>
          <span class="pasos__num">2</span>
          <Icono nombre="qr" tam={28} class="pasos__icono" />
          <h3>La instalas con un QR en 2 minutos.</h3>
          <p>Lo escaneas desde los ajustes del móvil y listo.</p>
        </li>
        <li>
          <span class="pasos__num">3</span>
          <Icono nombre="avion" tam={28} class="pasos__icono" />
          <h3>Aterrizas y tienes datos.</h3>
          <p>Activa los datos en itinerancia de la eSIM al llegar.</p>
        </li>
      </ol>
      <div class="pasos__notas texto">
        <p><strong>Sigues teniendo tu número de siempre para llamadas y SMS:</strong> la eSIM solo pone los datos.</p>
        <p>El plan empieza a contar cuando te conectas por primera vez en Marruecos, no cuando lo compras.</p>
      </div>
    </div>
  </section>

  <!-- 4. En Marruecos -->
  <section class="seccion" aria-labelledby="ma-titulo">
    <div class="contenedor">
      <p class="eyebrow">En Marruecos</p>
      <h2 id="ma-titulo">Lo que me <span class="acento">importa</span> allí</h2>
      <ul class="chips">
        <li>
          <span class="chips__icono"><Icono nombre="antena" tam={26} /></span>
          <span>Funciona con la red de <strong>Orange</strong>.</span>
        </li>
        <li>
          <span class="chips__icono"><Icono nombre="compartir" tam={26} /></span>
          <span>Puedes <strong>compartir datos</strong> con alguien del grupo.<small>Los datos compartidos salen del mismo plan.</small></span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 5. Cuántos GB -->
  <section class="seccion gb" aria-labelledby="gb-titulo">
    <div class="contenedor">
      <p class="eyebrow">Orientación</p>
      <h2 id="gb-titulo">¿Cuántos GB <span class="acento">necesito</span>?</h2>
      <div class="gb__fichas">
        <article class="gb__ficha">
          <p class="gb__cifra">3–5 GB</p>
          <div class="gb__barra" aria-hidden="true"><span style="--llenado: 45%"></span></div>
          <p>Una semana con WhatsApp, mapas y redes.</p>
        </article>
        <article class="gb__ficha">
          <p class="gb__cifra">10 GB</p>
          <div class="gb__barra" aria-hidden="true"><span style="--llenado: 100%"></span></div>
          <p>Si subes muchas fotos y vídeos (te veo, creador/a de stories).</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 6. Código -->
  <section id="codigo" class="seccion codigo" aria-labelledby="codigo-titulo">
    <div class="contenedor codigo__caja">
      <Forma tipo="cuarto" color="verde" tam="clamp(70px, 16vw, 120px)" class="codigo__forma" />
      <h2 id="codigo-titulo">Mi <span class="acento">código</span></h2>
      <CodigoDescuento id="codigo-pagina" transparencia="larga" />
      <div class="codigo__acciones">
        <EnlaceGlowi href={GLOWI.paises.marruecos} class="btn">
          <span>Ver eSIM para Marruecos</span>
          <span class="btn__flecha"><Icono nombre="flecha" tam={18} /></span>
        </EnlaceGlowi>
        <EnlaceGlowi href={GLOWI.compatibilidad} class="codigo__secundario">¿Mi móvil tiene eSIM?</EnlaceGlowi>
      </div>
      <p class="codigo__truco">
        <strong>Truco:</strong> marca <code>*#06#</code>. Si aparece un número EID, tu móvil es compatible.
      </p>
    </div>
  </section>

  <!-- 7. Cierre -->
  <section class="seccion cierre-i" aria-label="Otros destinos">
    <div class="contenedor texto">
      <p class="cierre-i__texto">
        ¿Vas a otro destino? <EnlaceGlowi href={GLOWI.home}>Glowi</EnlaceGlowi> tiene eSIM para muchos países.
      </p>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .ihero { padding-block: 8.5rem 3rem; overflow: hidden; }
  .ihero__rejilla { display: grid; gap: 3rem; align-items: center; }
  .ihero h1 { font-size: var(--t-xxl); line-height: .95; }
  .ihero__ancla {
    display: inline-flex; align-items: center; gap: .5rem; min-height: 48px;
    font-weight: 600; color: var(--azul);
  }
  .ihero__foto { position: relative; max-width: 420px; width: calc(100% - 14px); justify-self: center; }
  .ihero__foto .arco { aspect-ratio: 816 / 1150; }
  .ihero__circulo { position: absolute; z-index: 2; left: -12px; top: 18%; }
  @media (min-width: 960px) {
    .ihero__rejilla { grid-template-columns: 6fr 5fr; gap: 5rem; }
  }

  /* Pasos */
  .pasos { background: var(--papel); }
  .pasos__lista { list-style: none; padding: 0; margin: 2.5rem 0; display: grid; gap: 1.25rem; }
  .pasos__lista li {
    position: relative;
    padding: 1.5rem 1.5rem 1.5rem 5.25rem;
    border: 1px solid var(--linea); border-radius: var(--radio); background: var(--crema);
  }
  .pasos__num {
    position: absolute; left: 1.25rem; top: 1.35rem;
    display: grid; place-items: center;
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--rojo); color: var(--crema);
    font-family: var(--f-display); font-weight: 600; font-size: 1.4rem;
  }
  .pasos__lista li:nth-child(2) .pasos__num { background: var(--azul); }
  .pasos__lista li:nth-child(3) .pasos__num { background: var(--verde); }
  .pasos__lista :global(.pasos__icono) { color: var(--tinta-2); margin-bottom: .5rem; }
  .pasos__lista h3 { margin: 0 0 .25rem; }
  .pasos__lista p { margin: 0; color: var(--tinta-2); }
  .pasos__notas p { margin-bottom: .5rem; }
  @media (min-width: 860px) {
    .pasos__lista { grid-template-columns: repeat(3, 1fr); }
    .pasos__lista li { padding: 5.5rem 1.5rem 1.5rem; }
    .pasos__num { top: 1.5rem; left: 1.5rem; }
  }

  /* Chips */
  .chips { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; }
  .chips li {
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem 1.5rem 1rem 1rem;
    border-radius: var(--radio-pill);
    background: var(--verde); color: var(--crema);
    font-size: var(--t-l); line-height: 1.3;
  }
  .chips small { display: block; font-size: var(--t-s); margin-top: .2rem; }
  .chips__icono {
    display: grid; place-items: center; flex: none;
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--crema); color: var(--verde);
  }
  @media (min-width: 860px) { .chips { grid-template-columns: 1fr 1fr; } }

  /* GB */
  .gb { padding-top: 0; }
  .gb__fichas { display: grid; gap: 1.25rem; margin-top: 2rem; }
  .gb__ficha { background: var(--papel); border: 1px solid var(--linea); border-radius: var(--radio); padding: 1.5rem; }
  .gb__ficha p { margin: 0; }
  .gb__cifra { font-family: var(--f-display); font-weight: 600; font-size: var(--t-xl); line-height: 1; }
  .gb__barra { height: 14px; border-radius: var(--radio-pill); background: var(--crema); border: 1.5px solid var(--tinta); margin: 1rem 0; overflow: hidden; }
  .gb__barra span { display: block; height: 100%; width: var(--llenado); background: var(--azul); }
  @media (min-width: 760px) { .gb__fichas { grid-template-columns: 1fr 1fr; } }

  /* Código */
  .codigo { background: var(--papel); scroll-margin-top: 80px; }
  .codigo__caja {
    position: relative;
    max-width: calc(40rem + 2 * var(--lateral));
    display: grid; gap: 1.5rem;
  }
  .codigo__forma { position: absolute; right: var(--lateral); top: -1rem; }
  .codigo h2 { margin: 0; }
  .codigo__acciones { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; }
  .codigo__secundario { display: inline-flex; align-items: center; min-height: 48px; font-weight: 600; }
  .codigo__truco { margin: 0; color: var(--tinta-2); font-size: var(--t-s); }
  .codigo__truco code { font-family: var(--f-display); font-weight: 600; color: var(--tinta); }

  .cierre-i__texto { font-family: var(--f-display); font-weight: 500; font-size: var(--t-l); margin: 0; }
  .cierre-i__texto :global(a) { font-weight: 600; }
</style>
