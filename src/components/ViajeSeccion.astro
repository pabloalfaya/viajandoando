---
// Un viaje como sección a pantalla completa (foto de fondo, frase, código, destino enorme…).
import { Picture } from "astro:assets";
import { ESTADO, euros, fechasTexto, tienePrecio, type Viaje } from "../lib/viajes";
import Boton from "./Boton.astro";

interface Props {
  viaje: Viaje;
}
const { viaje } = Astro.props;
const d = viaje.data;
const fechas = fechasTexto(d);
const url = `/viajes/${viaje.id}/`;
---

<article class="viaje sobre-foto" aria-labelledby={`viaje-${viaje.id}`}>
  <div class="foto-fondo">
    <Picture formats={["avif", "webp"]} src={d.portada} alt="" widths={[480, 800, 1200, 1800]} sizes="100vw" quality={70} />
  </div>
  <div class="contenedor viaje__contenido">
    <p class="viaje__frase">{d.frase}</p>
    <p class="viaje__codigo"><span>{d.codigo}</span><span class="viaje__estado">{ESTADO[d.estado]}</span></p>
    <h3 class="viaje__destino" id={`viaje-${viaje.id}`}>{d.titulo}</h3>
    <dl class="viaje__datos">
      <div><dt>Cuándo</dt><dd>{fechas ?? "Fechas muy pronto"}</dd></div>
      <div><dt>Dónde</dt><dd>{d.lugar}</dd></div>
      <div><dt>Precio</dt><dd>{tienePrecio(d) ? euros(d.precio!) : "Muy pronto"}</dd></div>
    </dl>
    <blockquote class="viaje__cita">«{d.cita}»</blockquote>
    <Boton href={url} variante="crema" aria-label={`Quiero ir a ${d.titulo}${fechas ? `, ${fechas}` : ""}`}>Quiero ir</Boton>
  </div>
</article>

<style>
  .viaje {
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 7rem 4rem;
  }
  .viaje__contenido { display: grid; gap: .9rem; justify-items: start; }
  .viaje p { margin: 0; }
  .viaje__frase { font-size: var(--t-l); font-weight: 600; max-width: 30ch; }
  .viaje__codigo {
    display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center;
    font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .22em;
  }
  .viaje__estado { background: var(--verde); color: var(--crema); padding: .35em .9em; border-radius: var(--radio-pill); letter-spacing: .12em; }
  .viaje__destino {
    font-size: var(--t-xxl);
    font-weight: 600;
    text-transform: uppercase;
    line-height: .92;
    letter-spacing: -.01em;
    margin: .1em 0 .1em;
    overflow-wrap: anywhere;
  }
  .viaje__datos { display: flex; flex-wrap: wrap; gap: .75rem 2.5rem; margin: 0; }
  .viaje__datos dt { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .18em; }
  .viaje__datos dd { margin: 0; font-size: var(--t-m); }
  .viaje__cita { margin: .5rem 0 1rem; font-size: var(--t-l); max-width: 36ch; line-height: 1.35; }
</style>
