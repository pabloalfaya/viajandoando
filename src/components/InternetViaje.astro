---
// Caja «¿Cómo tendré internet en el viaje?». Va AL FINAL de cada página de viaje o destino,
// nunca en el layout global. El botón lleva a la eSIM del país; si no tiene URL verificada, a la portada de Glowi.
import { GLOWI, glowiPais } from "../config/glowi";
import CodigoDescuento from "./CodigoDescuento.astro";
import EnlaceGlowi from "./EnlaceGlowi.astro";
import Icono from "./Icono.astro";

interface Props {
  pais: string; // paisSlug, p. ej. "marruecos"
  nombre?: string; // nombre visible, p. ej. "Turquía"
}
const { pais, nombre = pais } = Astro.props;
const urlGlowi = glowiPais(pais) ?? GLOWI.home;
---

<aside class="internet" aria-labelledby="internet-titulo">
  <div class="internet__cabecera">
    <span class="internet__icono"><Icono nombre="senal" tam={20} /></span>
    <h2 id="internet-titulo">¿Cómo tendré internet en el viaje? Con Glowi eSIM</h2>
  </div>
  <p class="internet__texto">
    Yo viajo con Glowi eSIM: la instalas antes de salir y tienes datos nada más aterrizar, sin cambiar de número. Con mi
    código descuento de Glowi te ahorras un 10&nbsp;%.
  </p>
  <CodigoDescuento id={`codigo-${pais}`} transparencia="corta" condiciones />
  <div class="internet__acciones">
    <EnlaceGlowi href={urlGlowi} class="btn" aria-label={`Ir a Glowi eSIM: eSIM para ${nombre}`}>
      <span>Ir a Glowi eSIM</span>
      <span class="btn__flecha"><Icono nombre="flecha" tam={18} /></span>
    </EnlaceGlowi>
    <a href="/codigo-descuento-glowi/" class="internet__enlace">Mi código de Glowi y cómo funciona&nbsp;<span aria-hidden="true">→</span></a>
  </div>
</aside>

<style>
  .internet {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(1.25rem, 1rem + 2vw, 2rem);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    display: grid;
    gap: 1rem;
  }
  .internet__cabecera { display: flex; align-items: center; gap: .75rem; }
  .internet__cabecera h2 { font-size: var(--t-l); margin: 0; }
  .internet__icono {
    display: grid; place-items: center; flex: none;
    width: 36px; height: 36px; border-radius: 50%;
    border: 1px dashed var(--verde); color: var(--verde);
  }
  .internet__texto { margin: 0; color: var(--tinta-2); }
  .internet__acciones { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; }
  .internet__enlace {
    display: inline-flex; align-items: center; min-height: 48px;
    font-weight: 600; color: var(--azul);
  }
  .internet__enlace:hover { color: var(--rojo); }
</style>
