---
// Plantilla de páginas legales: noindex y fuera del sitemap.
import Base from "./Base.astro";

interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;
---

<Base titulo={titulo} descripcion={descripcion} noindex>
  <article class="legal contenedor">
    <p class="eyebrow">Legal</p>
    <h1>{titulo}</h1>
    <p class="legal__aviso">
      Plantilla pendiente de revisión: los datos marcados como «pendiente» se completarán antes de publicar.
    </p>
    <slot />
  </article>
</Base>

<style>
  .legal { padding-block: 9rem 5rem; max-width: calc(48rem + 2 * var(--lateral)); }
  .legal :global(h2) { font-size: var(--t-l); text-transform: none; margin-top: 2.5rem; }
  .legal :global(p), .legal :global(li) { color: var(--tinta-2); }
  .legal__aviso { padding: 1rem 1.25rem; border: 1.5px dashed var(--rojo); border-radius: var(--radio); }
</style>
