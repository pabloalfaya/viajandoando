---
// Cabecera flotante en píldora. Sin enlaces externos salvo Instagram (nunca Glowi).
// Orden del menú = orden de las secciones de la home; «Internet en el viaje» es página aparte.
import { instagramUrl } from "../config/site";
import { ESTADO, fechasCortas, getViajes } from "../lib/viajes";
import Icono from "./Icono.astro";
import Logo from "./Logo.astro";

const viajes = await getViajes();
const ruta = Astro.url.pathname;
const enViajes = ruta.startsWith("/viajes/");
---

<header class="cabecera">
  <div class="cabecera__pildora">
    <a href="/" class="cabecera__logo">
      <Logo tam={44} tamEscritorio={52} cargaInmediata />
    </a>
    <button
      type="button"
      class="cabecera__boton"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-boton
    >
      <span class="sr-only" data-menu-texto>Abrir menú</span>
      <Icono nombre="menu" class="i-abrir" />
      <Icono nombre="cerrar" class="i-cerrar" />
    </button>
    <nav id="menu-principal" class="cabecera__nav" aria-label="Principal" data-menu>
      <ul class="cabecera__lista">
        <li><a href="/#quien-soy">Quién soy</a></li>
        <li><a href="/#como-son">Cómo son</a></li>
        <li class="sub">
          <button
            type="button"
            class:list={["sub__boton", { "sub__boton--actual": enViajes }]}
            aria-expanded="false"
            aria-controls="submenu-viajes"
            data-sub-boton
          >
            Próximos viajes
            <svg class="sub__flecha" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
          <ul id="submenu-viajes" class="sub__lista" data-sub>
            {
              viajes.map((v) => {
                const href = `/viajes/${v.id}/`;
                return (
                  <li>
                    <a href={href} class="sub__viaje" aria-current={ruta === href ? "page" : undefined}>
                      <span class="sub__titulo">{v.data.titulo}</span>
                      <span class="sub__fechas">{fechasCortas(v.data) ?? "Fechas muy pronto"} · {ESTADO[v.data.estado]}</span>
                    </a>
                  </li>
                );
              })
            }
            <li><a href="/viajes/" class="sub__todos" aria-current={ruta === "/viajes/" ? "page" : undefined}>Ver todos los viajes →</a></li>
          </ul>
        </li>
        <li><a href="/#preguntas">Preguntas</a></li>
        <li>
          <a href="/internet-en-el-viaje/" aria-current={ruta === "/internet-en-el-viaje/" ? "page" : undefined}>Internet en el viaje</a>
        </li>
        <li class="cabecera__ig">
          <a href={instagramUrl} target="_blank" rel="noopener">
            <Icono nombre="instagram" titulo="Instagram de Viajando Ando" />
            <span class="cabecera__ig-texto">Instagram</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecera {
    position: fixed;
    z-index: 50;
    top: max(10px, env(safe-area-inset-top));
    left: var(--lateral);
    right: var(--lateral);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .cabecera__pildora {
    pointer-events: auto;
    width: 100%;
    max-width: var(--ancho);
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .35rem .4rem .35rem .4rem;
    border-radius: var(--radio-pill);
    background: var(--papel-velo);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid var(--linea);
  }
  .cabecera__logo { display: flex; align-items: center; min-height: 48px; color: var(--tinta); text-decoration: none; }
  .cabecera__boton {
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border: 0; border-radius: 50%;
    background: var(--tinta); color: var(--crema);
    cursor: pointer;
  }
  .cabecera__boton .i-cerrar { display: none; }
  .cabecera__boton[aria-expanded="true"] .i-cerrar { display: block; }
  .cabecera__boton[aria-expanded="true"] .i-abrir { display: none; }

  .cabecera__nav ul { list-style: none; margin: 0; padding: 0; }
  .cabecera__nav a {
    display: flex; align-items: center; gap: .5rem;
    min-height: 48px;
    color: var(--tinta);
    text-decoration: none;
  }
  .cabecera__nav a:hover, .cabecera__nav a[aria-current="page"] { color: var(--rojo); }

  /* Submenú «Próximos viajes» */
  .sub { position: relative; }
  .sub__boton {
    display: flex; align-items: center; gap: .4rem;
    min-height: 48px; padding: 0;
    border: 0; background: none; cursor: pointer;
    color: var(--tinta); font: inherit;
  }
  .sub__boton:hover, .sub__boton--actual { color: var(--rojo); }
  .sub__flecha { transition: rotate .2s ease; }
  .sub__boton[aria-expanded="true"] .sub__flecha { rotate: 180deg; }
  .sub__lista:not([data-abierto]) { display: none; }
  .cabecera__nav .sub__viaje { display: grid; gap: .1rem; align-content: center; padding-block: .5rem; }
  .sub__titulo { font-family: var(--f-display); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
  .sub__fechas { font-family: var(--f-body); font-size: var(--t-s); color: var(--tinta-2); }
  .cabecera__nav .sub__todos { font-weight: 600; color: var(--azul); }

  /* Móvil: panel desplegable */
  @media (max-width: 959px) {
    .cabecera__nav {
      position: fixed;
      inset: calc(max(10px, env(safe-area-inset-top)) + 70px) var(--lateral) auto;
      padding: 1rem 1.5rem 1.5rem;
      background: var(--papel);
      border-radius: calc(var(--radio) * 2);
      border: 1px solid var(--linea);
      max-height: calc(100dvh - 100px);
      overflow-y: auto;
    }
    .cabecera__nav:not([data-abierto]) { display: none; }
    .cabecera__nav li + li { border-top: 1px solid var(--linea); }
    .cabecera__lista > li > a, .sub__boton { font-family: var(--f-display); font-size: 1.45rem; padding-block: .45rem; width: 100%; }
    .cabecera__nav .sub__lista { padding: 0 0 .75rem 1rem; border-left: 3px solid var(--rojo); margin-left: .25rem; }
    .sub__lista li + li { border-top: 0; }
    .sub__titulo { font-size: 1.1rem; }
  }

  /* Escritorio */
  @media (min-width: 960px) {
    .cabecera__boton { display: none; }
    .cabecera__lista { display: flex; align-items: center; gap: 1.6rem; }
    .cabecera__lista > li > a, .sub__boton { font-size: var(--t-s); font-weight: 500; }
    .cabecera__nav .sub__lista {
      position: absolute; top: calc(100% + 12px); left: 50%; translate: -50% 0;
      width: max-content; min-width: 260px;
      padding: .5rem 1rem;
      background: var(--papel);
      border: 1px solid var(--linea);
      border-top: 3px solid var(--rojo);
      border-radius: var(--radio);
    }
    .sub__lista li + li { border-top: 1px solid var(--linea); }
    .sub__titulo { font-size: 1rem; }
    .cabecera__ig a {
      justify-content: center;
      width: 48px; border-radius: 50%;
      background: var(--tinta); color: var(--crema);
    }
    .cabecera__ig a:hover { background: var(--rojo); color: var(--crema); }
    .cabecera__ig-texto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
</style>

<script>
  // Menú móvil accesible: aria-expanded, cierre con Esc, al pulsar un enlace y bloqueo del scroll.
  const boton = document.querySelector<HTMLButtonElement>("[data-menu-boton]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const texto = document.querySelector<HTMLElement>("[data-menu-texto]");
  // Submenú «Próximos viajes»
  const subBoton = document.querySelector<HTMLButtonElement>("[data-sub-boton]");
  const sub = document.querySelector<HTMLElement>("[data-sub]");
  const fijarSub = (abierto: boolean) => {
    subBoton?.setAttribute("aria-expanded", String(abierto));
    sub?.toggleAttribute("data-abierto", abierto);
  };
  const subAbierto = () => subBoton?.getAttribute("aria-expanded") === "true";
  subBoton?.addEventListener("click", () => fijarSub(!subAbierto()));
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (subAbierto() && !t.closest(".sub") && !t.closest("[data-menu-boton]")) fijarSub(false);
  });

  if (boton && menu) {
    const fijar = (abierto: boolean) => {
      boton.setAttribute("aria-expanded", String(abierto));
      if (texto) texto.textContent = abierto ? "Cerrar menú" : "Abrir menú";
      menu.toggleAttribute("data-abierto", abierto);
      document.documentElement.classList.toggle("sin-scroll", abierto);
      // En móvil, al abrir el menú se ven ya los próximos viajes
      if (abierto && !matchMedia("(min-width: 960px)").matches) fijarSub(true);
    };
    boton.addEventListener("click", () => fijar(boton.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) {
        fijar(false);
        fijarSub(false);
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (subAbierto() && matchMedia("(min-width: 960px)").matches) {
        fijarSub(false);
        subBoton?.focus();
      } else if (boton.getAttribute("aria-expanded") === "true") {
        fijar(false);
        boton.focus();
      }
    });
    matchMedia("(min-width: 960px)").addEventListener("change", (e) => {
      if (e.matches) fijar(false);
      fijarSub(false);
    });
  }
</script>
